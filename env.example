# Airtable credentials
# airtable_to_postgres.py uses AIRTABLE_TOKEN; sync.py uses AIRTABLE_API_KEY + base/table below
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_TOKEN=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_NAME=your_table_name

# Database selection for sync.py (postgres or sqlserver)
DB_TYPE=postgres

# PostgreSQL connection — used by airtable_to_postgres.py
POSTGRES_DB=your_postgres_database
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL connection — used by sync.py
PG_DBNAME=your_postgres_database
PG_USER=your_postgres_username
PG_PASSWORD=your_postgres_password
PG_HOST=localhost
PG_PORT=5432

# SQL Server connection — used by sync.py (Windows Authentication, no password required)
SQLSERVER_HOST=localhost
SQLSERVER_DB=airtable_mirror
SQLSERVER_USER=
